---
import type { HTMLAttributes } from "astro/types";
import {
  getCldImageUrl,
  type GetCldImageUrlOptions,
} from "astro-cloudinary/helpers";

type CloudinaryFormat = "jxl" | "avif" | "webp";
type CloudinaryBreakpoint = number | { width: number };
type CloudinaryBreakpointSet =
  | CloudinaryBreakpoint[]
  | { breakpoints: CloudinaryBreakpoint[] };
type ImageAttrs = Omit<
  HTMLAttributes<"img">,
  "src" | "srcset" | "alt" | "width" | "height" | "sizes"
>;
type Transformations = Omit<
  GetCldImageUrlOptions,
  "src" | "width" | "height" | "format"
>;

/**
 * Art-direction device spec.
 *  - minWidth: viewport floor in px (0 = smallest device, the default crop
 *    rendered as the <img> fallback and the no-media <source>).
 *  - vw: how much of the viewport the image occupies -> per-source `sizes`.
 *  - aspectRatio: "16:9" | "4:3" | "1:1" | ... ; omit or "original" to keep
 *    the native ratio (crop: "limit"). Cropped ratios use crop: "fill".
 *
 * In MDX you can pass a compact string:
 *   devices="1200|40|original,992|60|16:9,768|70|4:3,0|100|1:1"
 * or an array from the frontmatter.
 */
type DeviceSpec = {
  minWidth: number;
  vw: number;
  aspectRatio?: string;
};

type Props = {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Simple responsive mode. Required when `devices` is not provided. */
  sizes?: string;
  breakpoints: CloudinaryBreakpointSet;
  /** Art-direction mode: per-device crops via <source media>. */
  devices?: string | DeviceSpec[];
  pictureClass?: string;
  transformations?: Transformations;
} & ImageAttrs;

const FORMAT_ORDER: CloudinaryFormat[] = ["jxl", "avif", "webp"];
const MIME_TYPES: Record<CloudinaryFormat, string> = {
  jxl: "image/jxl",
  avif: "image/avif",
  webp: "image/webp",
};

const {
  src,
  alt,
  width,
  height,
  sizes,
  breakpoints,
  devices,
  pictureClass,
  transformations = {},
  loading = "lazy",
  decoding = "async",
  ...attrs
} = Astro.props;

const getBreakpointWidth = (breakpoint: CloudinaryBreakpoint) =>
  typeof breakpoint === "number" ? breakpoint : breakpoint.width;

// 1. Make sure something was actually passed in.
if (!breakpoints) {
  throw new Error(
    `Cloudinary breakpoints are missing or undefined for src: "${src}". Please verify this key exists in your JSON file.`
  );
}

// 2. Safely extract the array whether it's a direct array or wrapped.
const breakpointList: CloudinaryBreakpoint[] = Array.isArray(breakpoints)
  ? breakpoints
  : breakpoints.breakpoints;

if (!breakpointList) {
  throw new Error(`Could not find a valid array of breakpoints for src: "${src}".`);
}

const normalizedBreakpoints: number[] = [
  ...new Set(
    breakpointList
      .map(getBreakpointWidth)
      .filter((b) => Number.isFinite(b) && b > 0)
      .concat(width)
  ),
].sort((a, b) => a - b);

if (normalizedBreakpoints.length === 0) {
  throw new Error(
    `Cloudinary breakpoints are required for ${src}. Run "npm run cloudinary:breakpoints ${src}" and pass the generated widths.`
  );
}

// --- Art direction -------------------------------------------------------

/** Parse "minWidth|vw|aspectRatio,..." into device specs. */
const parseDevicesString = (input: string): DeviceSpec[] =>
  input
    .split(",")
    .map((part) => {
      const seg = part.trim().split("|");
      return {
        minWidth: Number(seg[0]),
        vw: Number(seg[1]),
        aspectRatio: (seg[2] ?? "").trim() || undefined,
      };
    })
    .filter(
      (d) =>
        Number.isFinite(d.minWidth) &&
        d.minWidth >= 0 &&
        Number.isFinite(d.vw) &&
        d.vw > 0
    );

const rawDevices: DeviceSpec[] = Array.isArray(devices)
  ? devices
  : typeof devices === "string"
    ? parseDevicesString(devices)
    : [];

const artMode = rawDevices.length > 0;

// Largest minWidth first so the first matching <source media> wins; the
// smallest minWidth (ideally 0) is the default crop.
const deviceList: DeviceSpec[] = artMode
  ? [...rawDevices].sort((a, b) => b.minWidth - a.minWidth)
  : [];
const defaultDevice = artMode
  ? (deviceList.find((d) => d.minWidth === 0) ??
    deviceList[deviceList.length - 1])
  : undefined;

const isOriginal = (ar?: string) => !ar || ar === "original";

/** Crop params for a device: fill+aspectRatio for crops, limit for original. */
const cropFor = (device?: DeviceSpec) => {
  const ar = device?.aspectRatio;
  if (isOriginal(ar)) return { crop: "limit" as const };
  return {
    crop: "fill" as const,
    aspectRatio: ar,
    gravity: "center" as const,
  };
};

// --- URL builders --------------------------------------------------------

const createUrl = (format: CloudinaryFormat, breakpoint: number, device?: DeviceSpec) => {
  if (device) {
    return getCldImageUrl({
      quality: "auto",
      ...transformations,
      ...cropFor(device),
      src,
      width: breakpoint,
      format,
    });
  }
  // Simple responsive mode (unchanged behaviour).
  return getCldImageUrl({
    crop: "limit",
    quality: "auto",
    ...transformations,
    src,
    width: breakpoint,
    format,
  });
};

const createSrcSet = (format: CloudinaryFormat, device?: DeviceSpec) =>
  normalizedBreakpoints
    .map((bp) => `${createUrl(format, bp, device)} ${bp}w`)
    .join(", ");

// <img> layout box: reflect the default device's aspect ratio.
let imgWidth = width;
let imgHeight = height;
if (defaultDevice && !isOriginal(defaultDevice.aspectRatio)) {
  const parts = (defaultDevice.aspectRatio as string).split(":").map(Number);
  if (parts.length === 2 && parts[0] && parts[1]) {
    imgHeight = Math.round((width * parts[1]) / parts[0]);
  }
}

const imgSizes = artMode ? `${defaultDevice!.vw}vw` : sizes;
const fallbackSrc = createUrl("webp", width, defaultDevice);
---

<picture class={pictureClass}>
  {
    artMode ? (
      deviceList.flatMap((device) =>
        FORMAT_ORDER.map((format) => (
          <source
            type={MIME_TYPES[format]}
            media={device.minWidth > 0 ? `(min-width: ${device.minWidth}px)` : undefined}
            sizes={`${device.vw}vw`}
            srcset={createSrcSet(format, device)}
          />
        ))
      )
    ) : (
      FORMAT_ORDER.map((format) => (
        <source
          type={MIME_TYPES[format]}
          sizes={sizes}
          srcset={createSrcSet(format)}
        />
      ))
    )
  }
  <img
    {...attrs}
    src={fallbackSrc}
    alt={alt}
    width={imgWidth}
    height={imgHeight}
    sizes={imgSizes}
    loading={loading}
    decoding={decoding}
  />
</picture>
